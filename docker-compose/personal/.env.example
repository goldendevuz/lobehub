# ===========================
# ====== Personal deploy =====
# ===========================
# Copy to .env and fill in. Never commit .env.
#
# Binding: every published port binds to this address. Use the Tailscale IPv4
# of the host (or 127.0.0.1 for a local-only install). 0.0.0.0 is deliberately
# not the default.
LOBE_BIND_IP=127.0.0.1

# App image. Pin a release, or point at your own build:
#   LOBE_IMAGE=lobehub/lobehub:2.3.4
#   LOBE_IMAGE=ghcr.io/<owner>/lobehub:<tag>
LOBE_IMAGE=lobehub/lobehub:2.3.4
GATEWAY_IMAGE_TAG=0.5.0

# ===========================
# ====== Preset config ======
# ===========================
LOBE_PORT=3210
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
# Browser-facing URL of the app (Tailscale address, no trailing slash)
APP_URL=http://127.0.0.1:3210
# INTERNAL_APP_URL is used for internal server-to-server communication.
INTERNAL_APP_URL=http://localhost:3210

# Secrets (generate with `openssl rand -base64 32`)
KEY_VAULTS_SECRET=YOUR_KEY_VAULTS_SECRET
AUTH_SECRET=YOUR_AUTH_SECRET
# Shared token between LobeHub and the gateway service (openssl rand -hex 32)
GATEWAY_SERVICE_TOKEN=YOUR_GATEWAY_SERVICE_TOKEN
# RS256 key set that signs internal JWTs (single-line JSON, see personal/README.md)
JWKS_KEY=YOUR_JWKS_KEY
# The same key without its private fields; only this one is passed to the gateway
JWKS_PUBLIC_KEY=YOUR_JWKS_PUBLIC_KEY

# ===========================
# ====== Access control =====
# ===========================
# Only these emails may sign in. Empty = open registration, which is only
# acceptable while the app is reachable on a private network (Tailscale).
# AUTH_ALLOWED_EMAILS=you@example.com
# AUTH_DISABLE_EMAIL_PASSWORD=1   # SSO-only mode, do not enable without SSO

# ===========================
# ====== Database ===========
# ===========================
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# ===========================
# ====== Object storage =====
# ===========================
# Browser-facing endpoint (must match LOBE_BIND_IP / APP_URL host)
S3_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=YOUR_RUSTFS_PASSWORD
RUSTFS_LOBE_BUCKET=lobe

# ===========================
# ====== Agent Gateway ======
# ===========================
AGENT_GATEWAY_PORT=8787
DEVICE_GATEWAY_PORT=8788
# Browser-facing gateway address (must match LOBE_BIND_IP host)
AGENT_GATEWAY_URL=http://127.0.0.1:8787
# Device gateway address used by the LobeHub server inside the Compose network
DEVICE_GATEWAY_URL=http://gateway:8788
# Device gateway address advertised to desktop/CLI clients
# DEVICE_GATEWAY_PUBLIC_URL=http://127.0.0.1:8788

# ===========================
# ====== Model provider =====
# ===========================
# OmniRoute exposes an OpenAI-compatible endpoint. LobeHub's built-in OpenAI
# provider talks to it through OPENAI_PROXY_URL, so no other provider is needed.
OPENAI_API_KEY=YOUR_OMNIROUTE_KEY
OPENAI_PROXY_URL=http://100.87.98.68:20128/v1
# Drop the stock OpenAI models and expose only OmniRoute's router models.
OPENAI_MODEL_LIST=-all,auto=OmniRoute Auto,auto/best-coding=Best Coding,auto/best-reasoning=Best Reasoning,auto/best-fast=Best Fast,auto/best-vision=Best Vision
